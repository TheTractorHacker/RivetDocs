{
  "extends": "../../packages/config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["node", "jest"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
      "@rivetdocs/shared": ["../../packages/shared/dist/index.d.ts"],
      "@rivetdocs/shared/server": ["../../packages/shared/dist/server.d.ts"],
      "@rivetdocs/api/*": ["../api/dist/public/*.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.spec.ts"]
}
